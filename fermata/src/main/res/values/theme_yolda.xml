<?xml version="1.0" encoding="utf-8"?>
<!--
  Yolda Cam teması (Liquid Glass): Fermata'nın tüm ekranları Yolda ile aynı görünümde.
  Zemindeki canlı ışıklar MainActivityDelegate'te kök görünüme çizilir. Alt menü ve mini oynatıcı
  kodda havada duran oval cama çevrilir; burada çubuklar saydam, listeler berrak cam.
-->
<resources>

    <style name="AppTheme.YoldaGlass">

        <item name="android:colorBackground">#00000000</item>
        <item name="android:windowBackground">@color/yolda_base</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>

        <!-- Üst çubuk saydam; alt menü/oynatıcı kodda cam kapsül -->
        <item name="colorPrimaryDark">#00000000</item>
        <item name="colorPrimary">#00000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>

        <!-- Liste kartları: berrak cam -->
        <item name="colorSecondary">#2EFFFFFF</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="boxStrokeColor">#47FFFFFF</item>

        <!-- Seçili / çalan öğe: dolgun cam -->
        <item name="alpha">0.9</item>
        <item name="colorSecondaryVariant">#5CFFFFFF</item>
        <item name="android:textColorTertiary">#FFFFFF</item>

        <!-- Açılır menüler ve pencereler: koyu cam (okunurluk için) -->
        <item name="colorSurface">#E61A1E3D</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorPrimarySurface">#E61A1E3D</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>

        <item name="colorAccent">#FFFFFF</item>
        <item name="rippleColor">#40FFFFFF</item>
        <item name="android:textColorHint">#B3FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>

        <item name="cornerRadius">20dp</item>
    </style>

    <color name="yolda_base">#0B0E2A</color>

</resources>
